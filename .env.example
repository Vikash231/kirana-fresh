# Razorpay test mode (https://dashboard.razorpay.com/app/website-app-settings/api-keys)
# Leave unset to run against the built-in fake, which mirrors the Razorpay API shape.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini — drives the LLM buyer agent (npm run agent).
# Free key, no card: https://aistudio.google.com/apikey
# Unset => the deterministic planner is used instead and everything else still runs.
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: gemini-3.5-flash-lite (default, most generous free tier) or gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite
